model TaskStatus {
  id String @id @default(cuid())

  scope StatusScope @default(SYSTEM)

  targetId String

  name String

  order Int

  color String?

  isDefault Boolean @default(false)

  isClosed Boolean @default(false) // means this task is over

  tasks     Task[]
  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?

  @@unique([scope, targetId, name])
  @@unique([scope, targetId, order])
  @@map("task_statuses")
}

model TaskPriority {
  id String @id @default(cuid())

  scope StatusScope @default(SYSTEM)

  targetId String @default("") // organizationId workspaceId projectId

  name String

  order Int

  color String?

  isDefault Boolean @default(false)

  tasks Task[]

  @@unique([scope, targetId, name])
  @@map("task_priorities")
}

model Task {
  id String @id @default(cuid())

  projectId String

  parentTaskId String?

  title String

  taskStatusId String

  description String?

  comment String?

  priorityId String

  startDate DateTime?

  dueDate DateTime?

  completedAt DateTime?

  purchaseMinutes Int?

  estimatedMinutes Int?

  spentMinutes Int?

  team String? // e.g. "Frontend", "Backend", "DevOps", "Design"

  order Int @default(0)

  createdById String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  project Project @relation(fields: [projectId], references: [id])

  createdBy User @relation(fields: [createdById], references: [id])

  parentTask Task? @relation("SubTasks", fields: [parentTaskId], references: [id])

  subTasks Task[] @relation("SubTasks")

  status TaskStatus @relation(fields: [taskStatusId], references: [id])

  priority TaskPriority @relation(fields: [priorityId], references: [id])

  assignees TaskAssignee[]
  tags      TaskTag[]

  activities TaskActivity[]

  comments Comment[]
  attachments TaskAttachment[]

  @@index([projectId, deletedAt, order(sort: Desc)])
  @@index([projectId, taskStatusId, deletedAt])
  @@index([projectId])
  @@index([priorityId])
  @@map("tasks")
}

model TaskAssignee {
  id String @id @default(cuid())

  taskId String

  projectMemberId String

  assignedById String

  assignedAt DateTime @default(now())

  removedAt   DateTime?
  removedById String?

  task Task @relation(fields: [taskId], references: [id])

  projectMember ProjectMember @relation(fields: [projectMemberId], references: [id])
  removedBy     User?         @relation("TaskMemberRemovedBy", fields: [removedById], references: [id])

  assignedBy User @relation(fields: [assignedById], references: [id])

  @@index([projectMemberId, removedAt])
  @@unique([taskId, projectMemberId])
  @@map("task_assignees")
}

model TaskActivity {
  id String @id @default(cuid())

  taskId String

  userId String

  // eventType TaskEventType
  eventType String

  // entityType TaskActivityEntity
  entityType String

  entityId String?

  fieldName String?

  oldValue Json?

  newValue Json?

  message String?

  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id])

  actor User @relation(fields: [userId], references: [id])

  @@index([taskId, createdAt])
  @@index([eventType])
  @@index([userId])
  @@map("task_activities")
}

model Tag {
  id          String    @id @default(cuid())
  name        String
  color       String    @default("#3B82F6")
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  tasks       TaskTag[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([name, workspaceId])
  @@index([workspaceId])
  @@map("tags")
}

model TaskTag {
  taskId String
  tagId  String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("task_tags")
}

model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  uploadedById String

  name     String
  size     Int
  mimeType String
  url      String

  createdAt DateTime @default(now())

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([taskId])
  @@map("task_attachments")
}
